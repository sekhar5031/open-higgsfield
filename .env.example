HF_API_BASE_URL=
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# Local mode — the Local AI service in local-ai/. Only needed for local models;
# cloud models ignore these entirely.
LOCAL_AI_API_URL=http://127.0.0.1:8000
# Where the BROWSER reaches the same service. These differ under Docker or a
# tunnel, and generated asset URLs are written into history with this origin.
NEXT_PUBLIC_LOCAL_AI_URL=http://127.0.0.1:8000
