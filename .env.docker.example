# Copy to .env next to docker-compose.yml. Every value has a working default;
# these are the ones worth thinking about.

# Where weights and outputs live. Default is the named volume "ai-data".
# Set a host path to control the location — make sure it exists and is
# writable, and plan for ~40 GB for the first model.
# AI_DATA=/AI

# Change BOTH of these when the browser is not on the Docker host, e.g.
#   PUBLIC_LOCAL_AI_URL=http://gpu-box.lan:8000
#   AI_CORS_ORIGINS=http://gpu-box.lan:3000
PUBLIC_LOCAL_AI_URL=http://localhost:8000
AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

STUDIO_PORT=3000
LOCAL_AI_PORT=8000

# auto | cuda | cuda:1 | cpu
AI_DEVICE=auto
AI_DTYPE=bfloat16
# Models kept resident in VRAM. 1 suits a single 32 GB card.
AI_RESIDENT_MODELS=1

# Needed only for gated repositories such as FLUX.1-dev, whose licence must be
# accepted on its model card first.
# HF_TOKEN=

# Cloud models only — local generation needs neither.
# HF_API_BASE_URL=
# OPEN_HIGGSFIELD_READ_WRITE_TOKEN=
