# Where models, outputs and logs live. None of these may be inside the repo.
# Defaults to ~/.local/share/open-higgsfield-local-ai if AI_ROOT is unset, so
# the service runs before /AI exists.
AI_ROOT=/AI
# AI_MODEL_DIR=/AI/models
# AI_OUTPUT_DIR=/AI/outputs
# AI_ASSET_DIR=/AI/assets
# AI_CACHE_DIR=/AI/cache
# AI_LOG_DIR=/AI/logs

# Extra registry file merged over the built-in one, by model id.
# AI_MODEL_REGISTRY=/AI/models.json

AI_HOST=127.0.0.1
AI_PORT=8000
AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# auto | cuda | cuda:1 | cpu
AI_DEVICE=auto
# bfloat16 | float16 | float32 — bf16 is right for Blackwell.
AI_DTYPE=bfloat16
# Models kept resident in VRAM (LRU beyond this). 1 suits a single 32 GB card.
AI_RESIDENT_MODELS=1
# Refuse every network call; only already-downloaded weights can be used.
AI_OFFLINE=false

# Needed only for gated repositories such as FLUX.1-dev, whose licence must be
# accepted on its model card first.
# HF_TOKEN=
